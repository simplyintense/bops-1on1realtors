# Bops settings. Copy to .env.local and fill in what you use. Never commit .env.local.
# The person the bots work for (name, about) is set in the app: Settings → You.

# Self-hosting: 1 shows your providers' setup and status in Settings (network, email domain, phone
# service, computer ids), and the app calls every service directly with the keys below. The app is
# designed for hosted Bops, where all of that is run for the user: without this, a user signed in
# with Orgo reaches every service through Bops Cloud (cloud/README.md), and no keys sit on the Mac.
BOPS_SELF_HOSTED=1
# Usage events (README, Privacy). Signed in with Orgo, the app sends Orgo counts of what's done in Bops
# through PostHog, never content; self-hosting sends nothing. 0 turns them off on this Mac (so does
# DO_NOT_TRACK=1), and Bops Cloud then sends none for what this Mac does (account events the cloud
# sees on its own, like AI credit running out or a plan change, stop only with Settings → You →
# Share usage data). 1 sends them from a development build too, as environment "development".
BOPS_TELEMETRY=
# Which Bops Cloud a signed-in app works through (default https://bops.orgo.ai/api). Point it at
# staging or one running on this Mac (http://127.0.0.1:8790) while developing.
BOPS_CLOUD_URL=
# 1 turns brains on in a development build (Claude Code or Codex for a bot's tasks instead of Bops
# agent: Settings → Brain), read as `next dev` starts. Off by default; a release never has them
# (scripts/release.sh builds with 0).
NEXT_PUBLIC_BOPS_BRAINS=

# --- Required ---------------------------------------------------------------
# OpenAI: chat, calls (GPT-Live) and the bots' agent runs.
OPENAI_API_KEY=
# Key the bots' computers use for their own Codex runs (an OpenAI key; can be the same project).
OPENAI_EXECUTOR_API_KEY=
# Orgo: the bots' cloud computers. Users sign in with Orgo in the app, and Bops runs on their own
# account. This key is only for self-hosting: with BOPS_SELF_HOSTED=1 and ORGO_API_KEY set, the app
# skips the sign-in screen and uses this key (or ~/.orgo/credentials.json) whenever nobody is signed in.
ORGO_API_KEY=
# Which Orgo to sign in to and call (default https://www.orgo.ai). Point it at staging or a local
# Orgo while developing.
BOPS_ORGO_ORIGIN=
# Routing the bots' computers through this Mac (lib/server/relay.ts) runs the orgo-relay agent:
# this binary, else vendor/orgo-relay/orgo-relay (scripts/fetch-relay.sh), else one on PATH. The
# packaged app sets it to its bundled copy. Its loopback status API listens on BOPS_RELAY_CONTROL
# (default 127.0.0.1:8897).
BOPS_RELAY_BIN=
BOPS_RELAY_CONTROL=
# The Orgo workspace for Bops' computers, for self-hosting on ORGO_API_KEY. Unset, or with a user
# signed in: their own workspace named "bops" (made the first time).
# Bops only ever creates or deletes computers inside this workspace.
BOPS_ORGO_WORKSPACE=
# The Orgo template bot computers launch from (default system/bops-base@0.1.8, Orgo's own public copy,
# there for every account, and the only one a free Bops computer is made from). Build your own with
# `node orgo/bops-base.mjs publish` and put its ref here.
BOPS_ORGO_TEMPLATE=
# Disk per bot computer, in GB (default 120; your Orgo plan sets the most). Disks only ever grow.
BOPS_DISK_GB=

# --- Recommended ------------------------------------------------------------
# Typesafe: the small yes/no judgments (is this risky, which bot, is this a fact).
TYPESAFE_API_KEY=
# Composio: your connected apps (any of ~1,000, several accounts each) and the Slack app bots join
# channels through. User id defaults to one per install.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
# treg (treg.to): business data for every bot (companies, people, work emails, phones, company news,
# hiring and funding, local businesses, and the rest of treg's catalog). An org-scoped token
# (`treg org agent-new bops`); each call is paid from that team's treg balance. Set on a Mac signed in
# with Orgo, it's used instead of Bops Cloud's (to try business data before the cloud has it).
TREG_TOKEN=
# Honcho: long-term memory. Workspace and your peer id in it (defaults: "bops", "user").
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=
HONCHO_USER_PEER=
# Tailscale: lets bots' computers join your tailnet for a direct, private live view.
TAILSCALE_AUTH_KEY=
# 1 streams the bots' other screens live through Orgo (its noVNC proxy, ?screen=) when their computer
# isn't on the tailnet; otherwise they show as screenshots. Off by default until orgo.ai serves
# per-screen streams: an Orgo without them streams the main screen in a bot's tile instead.
BOPS_SCREEN_STREAM=

# --- 1on1 Realtors -------------------------------------------------------------
# Which team a fresh start gets: 1on1-realtors (default in this fork: Si.Leady, Si.Clienty,
# Si.Viewy, Si.Listingy, Si.Reporty; lib/realty-team.ts) or bops (upstream's Boppy alone).
BOPS_TEAM_PRESET=
# The 1on1realtors.com CRM (its Supabase backend), read-only by the realty_* tools (lib/server/realty-crm.ts).
# Use the publishable (anon) key and a dedicated bot login so the CRM's row-level security applies.
# NEVER the service-role key. Unset: the tools aren't offered.
ONEON1_CRM_URL=
ONEON1_CRM_ANON_KEY=
ONEON1_CRM_BOT_EMAIL=
ONEON1_CRM_BOT_PASSWORD=
# 1 lets `npm run realty:wa|realty:inbox -- --apply <proposals.json>` insert the APPROVED proposals
# (contact_submissions or crm_tasks rows only). The chat tools stay read-only. Keep 0 until reviewed.
ONEON1_CRM_WRITES=0

# --- Email (AgentMail) --------------------------------------------------------
AGENTMAIL_API_KEY=
# Domain for the bots' addresses (default bops.bot; a custom domain must be verified in AgentMail).
BOPS_MAIL_DOMAIN=
# Optional fixed pod (default: one per install).
AGENTMAIL_POD_ID=
# Your own email addresses, comma-separated, besides a connected Gmail, the ones verified in Settings
# and your Orgo sign-in email once you count it there: mail to these needs no approval, mail from them
# (DMARC passing) is you. Your bots' inboxes and agentmail.to or bops.bot addresses never count.
BOPS_OWNER_EMAILS=

# --- Phone (AgentPhone + GPT-Live over SIP) --------------------------------------
AGENTPHONE_API_KEY=
AGENTPHONE_SUB_ACCOUNT=
# Secret of the sub-account webhook (per-agent secrets are kept in .data/phone-secrets.json).
AGENTPHONE_WEBHOOK_SECRET=
# Public URL AgentPhone delivers to, e.g. https://api.example.com/hooks/agentphone (see edge/).
BOPS_AGENTPHONE_HOOK_URL=
# Area code for new bot numbers (default 415).
BOPS_PHONE_AREA=
# Texts (or emails) the code that proves a mobile number (or an email address) in Settings, How your
# bots reach you, is the user's (Twilio Verify). Only verified ones count as the user. Server
# secrets: never in the desktop app or a commit.
# The Verify service's SID (VA...), and an API key for it (or TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN).
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Countries codes may be texted to: calling codes, comma separated ("1,44"). Unset: US and Canada
# only (+1 without the Caribbean area codes; name one outright, like 1876, to allow it).
BOPS_VERIFY_COUNTRIES=
# Codes by email need an email sender attached to the Verify service (a SendGrid Email Integration).
# Unset: Bops reads the service's mailer_sid and offers email codes only when there is one. 0 turns
# email codes off; 1 skips that check (when the service has a sender but doesn't report it).
BOPS_VERIFY_EMAIL=
# Self-hosting override: mobile numbers that count as you WITHOUT a texted code, comma-separated.
# Anyone can put any number here, so never set it on a hosted (multi-user) server.
BOPS_OWNER_PHONES=
# Contact in the SMS HELP reply (carriers require one).
BOPS_SUPPORT_EMAIL=
# 1 = write texts into the chat instead of sending them (for testing routing).
BOPS_PHONE_DRY_RUN=
# OpenAI project webhook secret (live.transport.incoming, for calls).
OPENAI_WEBHOOK_SECRET=

# --- Hosted server ---------------------------------------------------------------
# Postgres for hosted Bops: each Orgo user's state in one database (see db/README.md). Unset, the
# Mac app keeps each user's state in Bops Cloud, and a self-hosted install (BOPS_SELF_HOSTED=1) in
# .data/users/<id>/state.json. Never commit the real one.
BOPS_DATABASE_URL=
# Pin this server to one Orgo user id; unset, it loads whoever signs in.
BOPS_ORGO_USER_ID=
# The name (or names, comma separated) people reach this hosted server by, e.g. bops.example.com.
# Behind a reverse proxy that rewrites Host, the public name the browser uses. Unset, a hosted server
# takes any name and only checks that requests come from its own page (proxy.ts).
BOPS_PUBLIC_HOST=

# --- Models (defaults in code) --------------------------------------------------
BOPS_CHAT_MODEL=
BOPS_SESSION_MODEL=
BOPS_HARD_MODEL=
BOPS_CHAT_EFFORT=
# New cloud tasks run on the Responses API's computer tool (lib/server/computer-task.ts); 0 puts them on an Agents API session instead
BOPS_COMPUTER_TOOL=

# --- Mac ---------------------------------------------------------------------
# Path to cua-driver (default ~/.local/bin/cua-driver).
CUA_DRIVER_PATH=
# 1 = show the background Chrome windows instead of running them headless.
BOPS_CHROME_WINDOWS=

# --- Optional: where Bops reaches Telegram and Discord (a proxy, or a stand-in for tests) ---
# Bots' Telegram and Discord tokens live in the Mac's Keychain, never here.
BOPS_TELEGRAM_API=
BOPS_DISCORD_API=

# --- Self-hosting only: Bops' public address and its own Slack app -------------
# Signed in with Orgo, Bops Cloud has both (its public address, and Orgo's "Bops" Slack app, whose
# events it passes to the Mac over the tunnel), and the app doesn't use these: set them with BOPS_SELF_HOSTED=1.
# Where the "connected" page, OAuth callbacks and the bots' pictures live (edge/, on Fly). Default api.bops.bot.
BOPS_PUBLIC_URL=
# Bops' own Slack app (slack/setup.mjs fills these): Slack shows "Bops" and each bot under its own name
# and picture, and Slack's events come to BOPS_PUBLIC_URL/hooks/slack, checked with the signing secret.
# Without them, Slack goes through Composio's shared app and its triggers.
BOPS_SLACK_APP_ID=
BOPS_SLACK_CLIENT_ID=
BOPS_SLACK_CLIENT_SECRET=
BOPS_SLACK_SIGNING_SECRET=
BOPS_SLACK_VERIFICATION_TOKEN=
BOPS_SLACK_AUTH_CONFIG=

# --- 1on1 Realtors: hosting at bop.1on1realtors.com (docs/1on1-realtors.md) ----------------------
# google puts Google sign-in in front of every page and API call (lib/gate.ts). Off when unset.
BOPS_LOGIN_GATE=
# Who may sign in: exact emails and/or "@1on1realtors.com" for a whole domain, comma separated.
BOPS_ALLOWED_EMAILS=
# 32+ random characters; signs the session cookie. Set it on the host only.
BOPS_GATE_SECRET=
# The site's public address; Google sends people back to <url>/api/gate/callback.
BOPS_PUBLIC_URL=
# A "Web application" OAuth client in the 1on1 Google Cloud project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The shared secret for the 1on1 staff MCP: it sends it as a bearer token to the read-only search (/api/realty/agent-search and /snapshot). Unset or wrong: 401. Every signed-in staff user gets the same rows; deskUrl links use BOPS_PUBLIC_URL.
BOPS_MCP_TOKEN=
# The shared secret for the 1on1 CRM's client matching: it sends it as a bearer token to POST /api/realty/automatch-client and /api/realty/automatch-vendor. Unset or blank: 503; missing or wrong: 401. No value here.
BOPS_AUTOMATCH_TOKEN=
# Size of the search database's volume in MB, for the percent used on /api/mcp/stats (optional; default 3072).
SEARCH_DB_QUOTA_MB=

# --- 1on1 Realtors: WhatsApp export reader and agent inbox sorter (realty/) ----------------------
# Google API client for the tools (can be the same client as above), and the 1on1 account's refresh
# token for the Drive folder (scope drive.readonly).
ONEON1_GOOGLE_CLIENT_ID=
ONEON1_GOOGLE_CLIENT_SECRET=
ONEON1_DRIVE_REFRESH_TOKEN=
# The Drive folder the daily WhatsApp "Export chat" files are dropped in.
ONEON1_WA_DRIVE_FOLDER_ID=
# The CRM agent id that gets leads and tasks nobody was named for (the admin lead).
ONEON1_DEFAULT_AGENT_ID=
# 1 turns the inbox sorter on (only after agents agree). Agents: slug:email:crmAgentId:Display Name, comma separated.
ONEON1_INBOX_SORTER=
ONEON1_INBOX_AGENTS=
# One per agent: ONEON1_GMAIL_REFRESH_TOKEN_<SLUG> (scope gmail.readonly; + gmail.compose for drafts).
# ONEON1_GMAIL_REFRESH_TOKEN_KERRY=
# 1 also saves reply drafts in the agent's own Gmail Drafts (never sent).
ONEON1_INBOX_GMAIL_DRAFTS=
# Asana project the proposed tasks are for (proposals only; nothing is created in Asana).
ONEON1_ASANA_PROJECT_ID=
# Where proposals are written (defaults .data/realty/whatsapp and .data/realty/inbox).
ONEON1_REALTY_OUT=
ONEON1_REALTY_OUT_INBOX=

# --- 1on1 Realtors: lead flow (realty/flow/, dry run only; docs/1on1-realtors.md) ----------------
# Who client messages come from: the brand, never an agent. Default "1 On 1 Realty".
ONEON1_ACK_SENDER_NAME=
# PLACEHOLDER until Wendy/Crystal confirm: mon-fri 08:00-17:00 Port of Spain. Set both to confirm.
# ONEON1_BUSINESS_HOURS=08:00-17:00
# ONEON1_BUSINESS_DAYS=mon-fri
# Agent answer window in business minutes, default 15 (1 to 240).
ONEON1_LEAD_TIMEOUT_MINUTES=
# tt-market-search for co-broke candidates; both needed, or the search is off.
ONEON1_MARKET_SEARCH_URL=
ONEON1_MARKET_SEARCH_TOKEN=
# ONEON1_MARKET_SEARCH_TIMEOUT_MS=4000
# The lead flow reads the CRM via ONEON1_CRM_* above (read-only) and never writes: leave ONEON1_CRM_WRITES off.

# --- 1on1 Realtors: Periskope WhatsApp intake (read-only, sends off; docs/1on1-realtors.md) ---------
# HMAC-SHA256 signing key from the Periskope webhook settings. Unset: the webhook answers 503.
PERISKOPE_SIGNING_KEY=
# Group allowlist, deny by default: exact group names, |-separated (trimmed). Other groups and direct messages are dropped.
PERISKOPE_ALLOWED_GROUPS=
# Exact WhatsApp group ids (ends in @g.us), |-separated. Either list may allow a group; both empty drops everything.
PERISKOPE_ALLOWED_CHAT_IDS=
# Optional extra chat_id allowlist (comma-separated). Empty: consent records alone decide.
PERISKOPE_ALLOWED_CHATS=
# Retention windows, in days. Buyer requests default 60; WhatsApp co-broke listings default 90.
# PERISKOPE_REQUEST_RETENTION_DAYS=60
# PERISKOPE_LISTING_RETENTION_DAYS=90
# market-ingest write endpoint and token (both needed, or the adapter stays dry-run / records only).
ONEON1_MARKET_WRITE_URL=
ONEON1_MARKET_INGEST_TOKEN=
# Staff alias posts stay dry-run unless this is 1 or true, because market-ingest does not accept kind "alias" yet.
ONEON1_MARKET_ALIAS_WRITE=

# --- 1on1 Realtors: Auto-Match Alert (live send is off until AUTOMATCH_ALERT_ENABLED is 1 or true) ---
# Live emails to every agent with a strong match (75+), as each new match happens. Deploy with this unset/false.
# AUTOMATCH_ALERT_ENABLED=false
# Explicit backlog send of already-known matches (off by default). Do not turn on without a yes.
# AUTOMATCH_ALERT_SEND_EXISTING=false
# Optional agent-email allowlist, comma-separated. Empty (the default) means every agent with a strong match.
# AUTOMATCH_ALERT_ALLOWLIST=
# From display name (default "1on1 Auto-Match Alert") and From address (default alerts@1on1realtors.com).
# AUTOMATCH_ALERT_FROM_NAME=
# AUTOMATCH_ALERT_FROM_ADDRESS=alerts@1on1realtors.com
# AUTOMATCH_ALERT_FROM_EMAIL=
# Reply-To (default admin@1on1realtors.com).
# AUTOMATCH_ALERT_REPLY_TO=admin@1on1realtors.com
# Comma-separated CC list. Default: admin@1on1realtors.com,wendy@1on1realtors.com
# AUTOMATCH_ALERT_CC=
# Staff CC on instant alerts (default on). When 0/false/off: no CC, BCC admin@ and Miles, Wendy is not copied.
# ALERT_CC_STAFF=true
# Comma-separated BCC list, not shown in the agent-facing headers or body. Default: miles@simplyintense.com
# AUTOMATCH_ALERT_BCC=
# Daily summary of the last 24 hours of alerts, to Wendy and admin, BCC Miles. Off until set to 1 or true.
# DAILY_SUMMARY_ENABLED=false
# Morning send time in AST (default 07:00).
# DAILY_SUMMARY_AT=07:00
# DAILY_SUMMARY_TO=wendy@1on1realtors.com,admin@1on1realtors.com
# DAILY_SUMMARY_BCC=miles@simplyintense.com
# Office address for unassigned listings (default admin@1on1realtors.com).
# AUTOMATCH_ALERT_OFFICE_EMAIL=
# Resend send-only API key (Fly secret RESEND_API_KEY). Never commit the value.
# RESEND_API_KEY=
